# Copy to backend/.env (never commit the real file)
OPENAI_API_KEY=your-openai-api-key
# Optional
OPENAI_MODEL=gpt-4o-mini
PORT=3000
# Comma-separated list of origins allowed to call the API, e.g. your Netlify URL.
# Leave empty to allow any origin (fine for local development only).
ALLOWED_ORIGINS=
